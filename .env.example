# Copia este archivo a .env y ajusta los valores

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/caritas_db"

# Secreto para firmar sesiones JWT (mínimo 32 caracteres, cámbialo en producción)
# Genera uno con: openssl rand -base64 32
SESSION_SECRET="genera-uno-con-openssl-rand-base64-32"

# URL base de la app (sin slash final)
APP_URL="http://localhost:3000"

# API key requerida por endpoints de sincronización móvil
MOBILE_SYNC_API_KEY="caritas-mobile-sync-2026"

# ─── Autenticación: Keycloak (OIDC) vía Auth.js v5 ──────────────────────────────
# Secreto de Auth.js (mínimo 32 chars). Genera uno con: openssl rand -base64 32
AUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Cliente OIDC registrado en el realm de Keycloak
AUTH_KEYCLOAK_ID="caritas-app"
AUTH_KEYCLOAK_SECRET="caritas-app-secret-dev"
# Issuer público (lo que ve el navegador). Siempre localhost en desarrollo local.
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/caritas"
# Solo en Docker Compose: URL interna para token/userinfo desde el contenedor web.
# AUTH_KEYCLOAK_INTERNAL_URL="http://keycloak:8080/realms/caritas"

# ─── Keycloak Admin API (provisión de usuarios desde la app) ─────────────────
# Necesario para registrar brigadistas (y otros usuarios) en Keycloak al crearlos.
# Usa admin-cli del master realm (incluido por defecto en Keycloak, sin config extra).
# KEYCLOAK_ADMIN_USER / KEYCLOAK_ADMIN_PASS son las credenciales del superadmin.
KEYCLOAK_ADMIN_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASS=

# ─── Email ────────────────────────────────────────────────────────────────────
#
# OPCIÓN A — Desarrollo local (MailHog, no envía emails reales)
# Levanta MailHog con Docker y ve los emails en http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="no-reply@caritas-lima.pe"

# OPCIÓN B — Gmail real (para staging o producción)
# Requisitos:
#   1. Verificación en 2 pasos activada en la cuenta Google
#   2. Generar contraseña de aplicación en:
#      https://myaccount.google.com/apppasswords
#      (elige "Otra aplicación", nómbrala "caritas-sistema")
#   3. Usa la contraseña de 16 caracteres generada (sin espacios)
#
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-cuenta@gmail.com"
# SMTP_PASS="abcdefghijklmnop"   # contraseña de aplicación (16 letras)
# SMTP_FROM="tu-cuenta@gmail.com"
