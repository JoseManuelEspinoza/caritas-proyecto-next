  resultado           String?
  fechaEvaluacion     DateTime?
  observacion         String?
  idCuestionarioCurso String?
  porcentajeObtenido  Decimal?              @db.Decimal(5, 2)
  puntajeObtenido     Decimal?              @db.Decimal(5, 2)
  puntajeTotal        Decimal?              @db.Decimal(5, 2)
  cuestionario        CuestionarioCurso?    @relation(fields: [idCuestionarioCurso], references: [idCuestionarioCurso])
  inscripcion         InscripcionCurso      @relation(fields: [idInscripcionCurso], references: [idInscripcionCurso])
