  descripcion             String?
  stockActual             Int             @default(0)
  estadoKit               String          @default("ACTIVO")
  fechaRegistro           DateTime        @default(now())
  ubicacionAlmacen        String?
  observaciones           String?
  articulos               KitArticulo[]
  parroquiaBeneficiaria   Parroquia?      @relation(fields: [idParroquiaBeneficiaria], references: [idParroquia])
  movimientos             MovimientoKit[]

  @@index([idParroquiaBeneficiaria], map: "idx_kit_parroquia")
  @@index([tipoKit, estadoKit], map: "idx_kit_tipo_estado")
  @@index([estadoKit, fechaRegistro], map: "idx_kit_estado_fecha")
  @@map("kit_emergencia")
}

/// Composición de un kit: qué artículos contiene y en qué cantidad.
/// Permite que el informe de incidencias precargue el contenido real del kit.
model KitArticulo {
  idKitArticulo   String        @id @default(uuid())
  idKitEmergencia String
  codigo          String?
  descripcion     String
  cantidad        Int           @default(1)
  orden           Int           @default(0)
  /// Stock disponible de ESTE elemento (el kit es solo una agrupación de elementos).
  stock           Int           @default(0)
  kitEmergencia   KitEmergencia @relation(fields: [idKitEmergencia], references: [idKitEmergencia], onDelete: Cascade)

  @@index([idKitEmergencia], map: "idx_kit_articulo_kit")
  @@map("kit_articulo")
}

model MovimientoKit {
  idMovimientoKit         String               @id @default(uuid())
  idKitEmergencia         String
  idUsuarioResponsableGRD String
  idParroquiaDestino      String?
  idActividadPreventiva   String?
  tipoMovimiento          String
  cantidad                Int
  motivoMovimiento        String?
  observaciones           String?
  fechaMovimiento         DateTime             @default(now())
  uuidMovil               String?              @unique
  syncEstado              String?
  fechaSincronizacion     DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  actividadPreventiva     ActividadPreventiva? @relation(fields: [idActividadPreventiva], references: [idActividadPreventiva])
  kitEmergencia           KitEmergencia        @relation(fields: [idKitEmergencia], references: [idKitEmergencia])
  parroquiaDestino        Parroquia?           @relation(fields: [idParroquiaDestino], references: [idParroquia])
  usuarioResponsable      UsuarioGRD           @relation(fields: [idUsuarioResponsableGRD], references: [idUsuarioGRD])

  @@index([idKitEmergencia, fechaMovimiento], map: "idx_movimiento_kit_fecha")
  @@index([idParroquiaDestino, fechaMovimiento], map: "idx_movimiento_parroquia_fecha")
  @@index([idUsuarioResponsableGRD, fechaMovimiento], map: "idx_movimiento_usuario_fecha")
  @@index([tipoMovimiento, fechaMovimiento], map: "idx_movimiento_tipo_fecha")
  @@index([idActividadPreventiva], map: "idx_movimiento_actividad")
  @@map("movimiento_kit")
}

model InstitucionAliada {
