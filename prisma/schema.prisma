}

model CertificacionCurso {
  idCertificacionCurso String                @id @default(uuid())
  idInscripcionCurso   String                @unique
  estadoCertificacion  String                @default("GENERADA")
  fechaCertificacion   DateTime?
  constanciaUrl        String?
  medioEnvioConstancia String?
  observacion          String?
  brigadista           BrigadistaParroquial?
  inscripcion          InscripcionCurso      @relation(fields: [idInscripcionCurso], references: [idInscripcionCurso])

  @@map("certificacion_curso")
}

model CuestionarioCurso {
  idCuestionarioCurso String                 @id @default(uuid())
  idCursoCapacitacion String
  titulo              String
  descripcion         String?
  tipoCuestionario    String                 @default("FINAL")
  notaAprobatoria     Decimal                @default(11.00) @db.Decimal(5, 2)
  maxIntentos         Int                    @default(3)
  estado              String                 @default("ACTIVO")
  fechaCreacion       DateTime               @default(now())
  curso               CursoCapacitacion      @relation(fields: [idCursoCapacitacion], references: [idCursoCapacitacion])
  evaluaciones        EvaluacionCurso[]
  preguntas           PreguntaCuestionario[]

  @@index([idCursoCapacitacion, estado])
  @@map("cuestionario_curso")
}

model PreguntaCuestionario {
  idPreguntaCuestionario String                @id @default(uuid())
  idCuestionarioCurso    String
  enunciado              String
  tipoPregunta           String                @default("OPCION_UNICA")
  puntaje                Decimal               @default(1.00) @db.Decimal(5, 2)
  orden                  Int
  estado                 String                @default("ACTIVO")
  opciones               OpcionPregunta[]
  cuestionario           CuestionarioCurso     @relation(fields: [idCuestionarioCurso], references: [idCuestionarioCurso])
  respuestas             RespuestaEvaluacion[]

  @@unique([idCuestionarioCurso, orden])
  @@index([idCuestionarioCurso, estado])
  @@map("pregunta_cuestionario")
}

model OpcionPregunta {
  idOpcionPregunta       String                @id @default(uuid())
  idPreguntaCuestionario String
  textoOpcion            String
  esCorrecta             Boolean               @default(false)
  orden                  Int
  estado                 String                @default("ACTIVO")
  pregunta               PreguntaCuestionario  @relation(fields: [idPreguntaCuestionario], references: [idPreguntaCuestionario])
  respuestas             RespuestaEvaluacion[]

  @@unique([idPreguntaCuestionario, orden])
  @@index([idPreguntaCuestionario, estado])
  @@map("opcion_pregunta")
}

model RespuestaEvaluacion {
  idRespuestaEvaluacion  String               @id @default(uuid())
  idEvaluacionCurso      String
  idPreguntaCuestionario String
  idOpcionPregunta       String?
  respuestaTexto         String?
  esCorrecta             Boolean?
  puntajeObtenido        Decimal?             @db.Decimal(5, 2)
  fechaRespuesta         DateTime             @default(now())
  evaluacion             EvaluacionCurso      @relation(fields: [idEvaluacionCurso], references: [idEvaluacionCurso])
  opcion                 OpcionPregunta?      @relation(fields: [idOpcionPregunta], references: [idOpcionPregunta])
  pregunta               PreguntaCuestionario @relation(fields: [idPreguntaCuestionario], references: [idPreguntaCuestionario])

  @@unique([idEvaluacionCurso, idPreguntaCuestionario])
  @@index([idEvaluacionCurso])
  @@index([idPreguntaCuestionario])
  @@index([idOpcionPregunta])
  @@map("respuesta_evaluacion")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notificacion {
  idNotificacion String      @id @default(uuid())
  userId         String
  tipo           String
  titulo         String
  mensaje        String
  enlace         String?
  leida          Boolean     @default(false)
  createdAt      DateTime    @default(now())
  idIncidencia   String?
  incidencia     Incidencia? @relation(fields: [idIncidencia], references: [idIncidencia])
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida, createdAt])
  @@index([idIncidencia, tipo, createdAt])
  @@map("notificaciones")
}

enum Role {
  ADMINISTRADOR
  ESPECIALISTAGRD
  BRIGADISTA
  COMITEDONACIONES
  JEFAOGP
}

enum EstadoRondaVotacionComite {
  ABIERTA
  CERRADA_APROBADA
  CERRADA_RECHAZADA
  CERRADA_OBSERVADA
}

enum DecisionVotoComite {
  A_FAVOR
  EN_CONTRA
}
