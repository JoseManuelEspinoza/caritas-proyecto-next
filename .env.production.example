# ════════════════════════════════════════════════════════════════════════════
# PLANTILLA de producción. Copia a `.env.production` en el servidor y rellena.
# NUNCA subas `.env.production` a git (ya está en .gitignore).
# ════════════════════════════════════════════════════════════════════════════

# ─── Base de datos de la APP (AWS RDS PostgreSQL) ────────────────────────────
DATABASE_URL="postgresql://USUARIO:PASSWORD@tu-rds-endpoint:5432/caritas_db?sslmode=require"

# ─── Auth.js v5 + Keycloak (OIDC) ────────────────────────────────────────────
# Genera el secreto con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-min-32-caracteres"
AUTH_URL="https://app.tudominio.com"
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID="caritas-app"
AUTH_KEYCLOAK_SECRET="el-secret-del-client-en-keycloak"
AUTH_KEYCLOAK_ISSUER="https://auth.tudominio.com/realms/caritas"

# ─── Servicio Keycloak (lo usa docker-compose.prod.yml) ──────────────────────
KC_HOSTNAME="https://auth.tudominio.com"
KEYCLOAK_ADMIN="admin"
KEYCLOAK_ADMIN_PASSWORD="password-admin-fuerte"
KEYCLOAK_DB_PASSWORD="password-bd-keycloak-fuerte"

# ─── Amazon S3 (evidencias) — usa llaves ROTADAS, no las del chat ────────────
AWS_REGION="us-east-1"
AWS_S3_BUCKET="caritas-evidencia"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# ─── Consulta de DNI (RENIEC) ────────────────────────────────────────────────
RENIEC_API_URL="https://dniruc.apisperu.com/api/v1/dni/{dni}?token={token}"
RENIEC_AUTH_MODE="query"
RENIEC_API_TOKEN="tu-token"

# ─── Email (SMTP real, no MailHog) ───────────────────────────────────────────
SMTP_HOST="smtp.tuproveedor.com"
SMTP_PORT="587"
SMTP_USER="usuario"
SMTP_PASS="password"
SMTP_FROM="no-reply@tudominio.com"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="https://app.tudominio.com"
NODE_ENV="production"
